# Configuration de la base de données PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/your_database_name"

# Remplacez les valeurs par vos informations de connexion réelles
# username: nom d'utilisateur de votre base de données
# password: mot de passe de votre base de données
# localhost: host de votre base de données
# 5432: port PostgreSQL (par défaut)
# your_database_name: nom de votre base de données
